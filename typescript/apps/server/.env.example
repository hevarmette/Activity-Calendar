DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
DB_SCHEMA=your_schema
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
TIMEZONE=America/Chicago
# Comma-separated allowlist of additional Postgres schemas that read-only routes
# may target via the global schema switcher / ?schema= param (Feature #6/#7).
# The primary DB_SCHEMA is always readable and need not be listed. Leave empty
# for a single-schema (single-user) install.
DB_COMPARE_SCHEMAS=
